# Copy to server/.env for local use. Never commit an actual .env file.
PLATFORM_LOCAL=true
PLATFORM_ENV=local
APP_URL=http://localhost:4310
API_URL=http://localhost:3301
LOCAL_DATA_DIR=../.platform-local
RELEASE_DIRECTORY=../.platform-build/releases

# Deployed values belong in a separate AWS Secrets Manager secret per environment.
# DATABASE_URL=postgresql://...-pooler...neon.tech/...?...sslmode=require
# BETTER_AUTH_SECRET=<at-least-32-random-characters>
# RESEND_API_KEY=re_...
# EMAIL_FROM=Science Labs <labs@your-verified-domain.example>

# Enable only after choosing prices and configuring a signed Stripe webhook.
STRIPE_BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_TEACHER_MONTHLY_PRICE=price_...
# STRIPE_TEACHER_ANNUAL_PRICE=price_...
# STRIPE_SCHOOL_ANNUAL_PRICE=price_...

# Optional OpenAI draft suggestions. Server-only; never use a VITE_ key.
OPENAI_DRAFTING_ENABLED=false
# OPENAI_API_KEY=...
# OPENAI_MODEL=gpt-5-mini
# OPENAI_HOURLY_LIMIT=10

# Optional Google sign-in; use different OAuth clients for development/production.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# Production: APP_URL=https://prepdrawer.com
# Production: API_URL=https://api.prepdrawer.com
# Google callback: https://api.prepdrawer.com/api/auth/callback/google
# Verify mail.prepdrawer.com with Resend before using its sender address.
